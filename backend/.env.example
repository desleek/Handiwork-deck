# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://handiwork:handiwork@localhost:5432/handiwork
REDIS_URL=redis://localhost:6379
PUBLIC_API_URL=http://localhost:4000

# --- Auth (Firebase) ---
# AUTH_MODE=dev accepts an `x-dev-user-id` header instead of a Firebase ID token. NEVER use in production.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Admin web panel (public Firebase web config)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Payments (provider-agnostic; leave keys empty to use the mock provider) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLE_MOCK=true

# --- WhatsApp Business (Meta Cloud API). Empty = log to console ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# --- Email (escalations) ---
EMAIL_FROM=no-reply@handiworkdeck.com
SMTP_URL=

# --- File storage: "s3" | "cloudinary" | "local" ---
STORAGE_DRIVER=local
AWS_REGION=eu-west-1
S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
