{
  "name": "@handiwork/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Handiwork-Deck marketplace API (Express + PostgreSQL + BullMQ)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bullmq": "^5.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.8.0"
  }
}
