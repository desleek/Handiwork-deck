NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://handiwork:handiwork@localhost:5432/handiwork
REDIS_URL=redis://localhost:6379

# --- Auth (Firebase) ---
# "firebase" verifies Firebase ID tokens. "dev" additionally accepts `Bearer dev:<firebase_uid>`
# for local work and tests; it is refused when NODE_ENV=production.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Base64 of the service-account JSON (leave empty to use Application Default Credentials).
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Payments ---
# mock = development/test gateway (refused in production). Gateway routing priority and
# fallback per currency are admin settings (payment_routing), not env vars; a gateway is
# only used once its secret key below is set.
PAYMENT_DEFAULT_PROVIDER=mock
# Commission rates, markup cap, receipt thresholds, payout fees and promotion prices are
# admin-configurable at runtime (PUT /v1/admin/settings/:key), not env vars.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- WhatsApp Business (Cloud API) relay ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# The platform-owned number shown to users as wa.me link (digits only, E.164 without +)
WHATSAPP_DISPLAY_NUMBER=

# --- Email (price-challenge escalations etc.): log | sendgrid ---
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
EMAIL_FROM=HANDIWORK-DECK <no-reply@handiwork-deck.app>

# --- File storage: s3 | cloudinary ---
STORAGE_DRIVER=s3
AWS_REGION=eu-west-1
S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Escalation timings (minutes) ---
ESCALATE_NO_QUOTE_WIDEN_AFTER_MIN=15
ESCALATE_NO_QUOTE_ADMIN_AFTER_MIN=60
ESCALATE_NO_SHOW_AFTER_MIN=30
MATCH_WIDEN_RADIUS_FACTOR=2
