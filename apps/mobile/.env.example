# Base URL of the HANDIWORK-DECK API (use your LAN IP when testing on a device)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Firebase web config (Project settings -> Your apps). Leave empty to use dev sign-in
# against an API running with AUTH_MODE=dev.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
